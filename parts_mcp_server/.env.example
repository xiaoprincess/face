# 从小智控制台获取的 MCP WebSocket 地址。不要提交真实令牌。
XIAOZHI_MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=replace-with-your-token

# 留空时默认读取相邻 unified_web_app 的数据库。
# PARTS_DB_PATH=../unified_web_app/instance/unified.db

# MCP 调用本机统一网站来完成借用、人脸识别和云台控制。
PARTS_WEB_BASE_URL=http://127.0.0.1:5050
# 与 unified_web_app/.env 中的 PARTS_DEVICE_TOKEN 设置为同一个随机值。
# PARTS_DEVICE_TOKEN=replace-with-a-long-random-token
# 人脸识别与云台操作最长等待秒数，范围为 5 到 90。
# PARTS_BORROW_TIMEOUT_SECONDS=45
