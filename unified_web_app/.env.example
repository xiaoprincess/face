# 树莓派设备接口认证。必须与 ../parts_mcp_server/.env 中的值一致。
PARTS_DEVICE_TOKEN=replace-with-a-long-random-token

# 摄像头临时不可用时可设为 true：跳过人脸和指柜，直接用系统账号登记借用记录（无需审批）。
# 摄像头修复后应恢复为 false。
PARTS_SKIP_FACE_VERIFICATION=false
PARTS_FALLBACK_APPLICANT_EMAIL=xiaozhi-bot@local.test

# 百度人脸识别。请填写你自己的凭据，不要提交真实值。
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_GROUP_ID=equipment_users

# 可选：固定网站会话密钥；留空时网站会在 instance 目录生成本机密钥。
# UNIFIED_SECRET_KEY=

# 云盘容量（字节）；已有文件不会因降低配额而自动删除。
# CLOUD_USER_QUOTA_BYTES=268435456
# CLOUD_SITE_QUOTA_BYTES=2147483648
# CLOUD_MAX_FILE_BYTES=16777216
